EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Token público de Mapbox (Access tokens > default public token), se embebe en la app
EXPO_PUBLIC_MAPBOX_TOKEN=pk.eyJ1Ijoi...

# Token SECRETO de Mapbox con scope "Downloads:Read" (Access tokens > Create a token),
# solo se usa al compilar (prebuild/EAS) para descargar el SDK nativo de Mapbox. NO se
# embebe en la app. Necesario para builds de Android; en iOS además hay que loguearse
# una vez con `npx pod-install` usando este token como contraseña del registro CocoaPods.
MAPBOX_DOWNLOAD_TOKEN=sk.eyJ1Ijoi...
